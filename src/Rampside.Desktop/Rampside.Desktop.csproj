<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Description>Rampside desktop window: live status and commands beside the sim (or a fake sim with --fake / --fake-pmdg).</Description>
    <RootNamespace>Rampside.Desktop</RootNamespace>
    <AssemblyName>Rampside</AssemblyName>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationIcon>..\..\assets\rampside.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Same icon as a WPF resource for MainWindow.Icon. Source: assets/rampside.svg, built by tools/icon/build_icon.py. -->
    <Resource Include="..\..\assets\rampside.ico" Link="rampside.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Rampside.Hosting\Rampside.Hosting.csproj" />
  </ItemGroup>

</Project>
