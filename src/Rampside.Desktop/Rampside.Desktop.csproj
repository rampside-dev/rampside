<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Description>Rampside desktop window: live status and commands beside the sim (or a fake sim with --fake / --fake-pmdg).</Description>
    <RootNamespace>Rampside.Desktop</RootNamespace>
    <AssemblyName>Rampside</AssemblyName>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Rampside.Hosting\Rampside.Hosting.csproj" />
  </ItemGroup>

</Project>
