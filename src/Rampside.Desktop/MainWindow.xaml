<Window x:Class="Rampside.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Rampside.Desktop"
        xmlns:vm="clr-namespace:Rampside.Desktop.ViewModels"
        Title="Rampside"
        Icon="rampside.ico"
        Width="520" Height="820" MinWidth="440" MinHeight="480"
        Background="{StaticResource WindowBackground}"
        Foreground="{StaticResource TextPrimary}"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        UseLayoutRounding="True">

    <Window.Resources>
        <local:BoolToVisibilityConverter x:Key="VisibleWhen" />
        <local:BoolToVisibilityConverter x:Key="CollapsedWhen" Invert="True" />

        <Style x:Key="Detail" TargetType="TextBlock" BasedOn="{StaticResource Muted}">
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="ToolTip" Value="{x:Null}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>
        <Style x:Key="PrimaryAction" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>
        <Style x:Key="DangerAction" TargetType="Button" BasedOn="{StaticResource DangerButton}">
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>

        <!--
          Update button: like the primary button, but its background fills from the left with the download
          progress (DownloadProgress, 0..1, from the data context). It stays coloured while disabled during the download.
        -->
        <Style x:Key="ProgressButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" SnapsToDevicePixels="True" />
                            <!--
                              The mask keeps the fill inside the rounded corners at any width. The transparent
                              background makes the mask span the whole button, not just the fill.
                            -->
                            <Grid Background="Transparent">
                                <Grid.OpacityMask>
                                    <VisualBrush Visual="{Binding ElementName=Bd}" />
                                </Grid.OpacityMask>
                                <Border Background="{StaticResource Accent}" Opacity="0.4" RenderTransformOrigin="0,0.5">
                                    <Border.RenderTransform>
                                        <ScaleTransform ScaleX="{Binding DownloadProgress}" />
                                    </Border.RenderTransform>
                                </Border>
                            </Grid>
                            <Border x:Name="Overlay" Background="White" Opacity="0" CornerRadius="4" />
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center"
                                              VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Overlay" Property="Opacity" Value="0.06" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Overlay" Property="Opacity" Value="0.12" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Overlay" Property="Opacity" Value="0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Status of a service: neutral when idle, amber while moving, green when active or done, red when aborted. -->
        <DataTemplate x:Key="StatusPill" DataType="{x:Type vm:ServiceViewModel}">
            <Border x:Name="Pill" CornerRadius="9" Padding="8,1,8,2" Margin="0,0,10,0" VerticalAlignment="Center"
                    HorizontalAlignment="Left" Background="{StaticResource ControlBackground}">
                <TextBlock x:Name="PillText" Text="{Binding Status}" FontSize="11" Foreground="{StaticResource TextSecondary}" />
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Starting">
                    <Setter TargetName="Pill" Property="Background" Value="{StaticResource WarnBackground}" />
                    <Setter TargetName="PillText" Property="Foreground" Value="{StaticResource Warn}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Finishing">
                    <Setter TargetName="Pill" Property="Background" Value="{StaticResource WarnBackground}" />
                    <Setter TargetName="PillText" Property="Foreground" Value="{StaticResource Warn}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Active">
                    <Setter TargetName="Pill" Property="Background" Value="{StaticResource GoodBackground}" />
                    <Setter TargetName="PillText" Property="Foreground" Value="{StaticResource Good}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Completed">
                    <Setter TargetName="Pill" Property="Background" Value="{StaticResource GoodBackground}" />
                    <Setter TargetName="PillText" Property="Foreground" Value="{StaticResource Good}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Aborted">
                    <Setter TargetName="Pill" Property="Background" Value="{StaticResource BadBackground}" />
                    <Setter TargetName="PillText" Property="Foreground" Value="{StaticResource Bad}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Name, status and detail; the shared size groups align the columns of all services. -->
        <DataTemplate x:Key="ServiceHeader" DataType="{x:Type vm:ServiceViewModel}">
            <Grid MinHeight="26">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="ServiceName" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="ServiceStatus" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0" />
                <ContentControl Grid.Column="1" Content="{Binding}" ContentTemplate="{StaticResource StatusPill}" Focusable="False" />
                <TextBlock Grid.Column="2" Text="{Binding Detail}" Style="{StaticResource Detail}" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ServiceProgress" DataType="{x:Type vm:ServiceViewModel}">
            <Grid Margin="0,4,0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ProgressBar Value="{Binding ProgressValue, Mode=OneWay}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding ProgressText}" Style="{StaticResource Muted}" FontSize="11"
                           MinWidth="40" TextAlignment="Right" />
            </Grid>
        </DataTemplate>

        <!-- Services without own actions -->
        <DataTemplate DataType="{x:Type vm:ServiceViewModel}">
            <StackPanel>
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ServiceHeader}" Focusable="False" />
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ServiceProgress}" Focusable="False"
                                Visibility="{Binding HasProgress, Converter={StaticResource VisibleWhen}}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ConnectableServiceViewModel}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ServiceHeader}" Focusable="False" VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="{Binding ToggleText}" Command="{Binding ToggleCommand}" MinWidth="108" Margin="8,0,0,0"
                        AutomationProperties.Name="{Binding DisplayName, StringFormat=Toggle {0}}" />
                <ContentControl Grid.Row="1" Grid.ColumnSpan="2" Content="{Binding}" ContentTemplate="{StaticResource ServiceProgress}" Focusable="False"
                                Visibility="{Binding HasProgress, Converter={StaticResource VisibleWhen}}" />
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:RefuelingViewModel}">
            <StackPanel>
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ServiceHeader}" Focusable="False" />
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ServiceProgress}" Focusable="False"
                                Visibility="{Binding HasProgress, Converter={StaticResource VisibleWhen}}" />
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <TextBox Width="190" Margin="0,0,6,0" Tag="{Binding Hint}" AutomationProperties.Name="Target fuel in kg"
                             Text="{Binding TargetKgText, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Return" Command="{Binding RefuelCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                    <Button Content="Refuel" Command="{Binding RefuelCommand}" Style="{StaticResource PrimaryAction}" />
                    <Button Content="Abort" Command="{Binding AbortCommand}" Style="{StaticResource DangerAction}"
                            AutomationProperties.Name="Abort refueling" />
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:PassengersViewModel}">
            <StackPanel>
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ServiceHeader}" Focusable="False" />
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ServiceProgress}" Focusable="False"
                                Visibility="{Binding HasProgress, Converter={StaticResource VisibleWhen}}" />
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <TextBox Width="130" Margin="0,0,6,0" Tag="{Binding Hint}" AutomationProperties.Name="Passengers to board"
                             Text="{Binding PassengersText, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Return" Command="{Binding BoardCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                    <Button Content="Board" Command="{Binding BoardCommand}" Style="{StaticResource PrimaryAction}" />
                    <Button Content="Deboard" Command="{Binding DeboardCommand}" Style="{StaticResource ActionButton}" />
                    <Button Content="Abort" Command="{Binding AbortCommand}" Style="{StaticResource DangerAction}"
                            AutomationProperties.Name="Abort boarding" />
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:PushbackViewModel}">
            <StackPanel>
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ServiceHeader}" Focusable="False" />
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ServiceProgress}" Focusable="False"
                                Visibility="{Binding HasProgress, Converter={StaticResource VisibleWhen}}" />
                <TextBlock Text="{Binding MotionText}" Style="{StaticResource Muted}" Margin="0,2,0,0"
                           Visibility="{Binding IsBusy, Converter={StaticResource VisibleWhen}}" />
                <!-- Planned pushback: one button per compass direction the nose can end up facing. -->
                <StackPanel Margin="0,8,0,0" Visibility="{Binding HasDirections, Converter={StaticResource VisibleWhen}}">
                    <TextBlock Text="{Binding DirectionsTitle}" Style="{StaticResource Label}" Margin="0,0,0,4" />
                    <!-- One option per row, so long GSX names stay readable. -->
                    <ItemsControl ItemsSource="{Binding Directions}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding Name}" Command="{Binding Command}" ToolTip="{Binding ToolTip}"
                                        Style="{StaticResource PrimaryAction}" Margin="0,0,0,6"
                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                        AutomationProperties.Name="{Binding ToolTip}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                <TextBlock Text="{Binding DirectionsHint}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0" />
                <WrapPanel Margin="0,6,0,0">
                    <Button Content="Call tug" Command="{Binding CallCommand}" Style="{StaticResource PrimaryAction}" Margin="0,0,12,0"
                            Visibility="{Binding HasDirections, Converter={StaticResource CollapsedWhen}}" />
                    <Button Content="Manual" Command="{Binding CallCommand}" Style="{StaticResource ActionButton}" Margin="0,0,12,0"
                            Visibility="{Binding HasDirections, Converter={StaticResource VisibleWhen}}"
                            ToolTip="Call the tug and steer by hand" AutomationProperties.Name="Call tug, steer by hand" />
                    <Button Content="Tail left" Command="{Binding TailLeftCommand}" Style="{StaticResource ActionButton}" Margin="0,0,2,0" />
                    <Button Content="Straight" Command="{Binding StraightCommand}" Style="{StaticResource ActionButton}" Margin="0,0,2,0" />
                    <Button Content="Tail right" Command="{Binding TailRightCommand}" Style="{StaticResource ActionButton}" Margin="0,0,12,0" />
                    <Button Content="Stop" Command="{Binding StopCommand}" Style="{StaticResource ActionButton}"
                            AutomationProperties.Name="Stop pushback" />
                    <Button Content="Abort" Command="{Binding AbortCommand}" Style="{StaticResource DangerAction}"
                            AutomationProperties.Name="Abort pushback" />
                </WrapPanel>
            </StackPanel>
        </DataTemplate>

        <!-- Separator line between service rows; the content picks its template by view model type. -->
        <DataTemplate x:Key="ServiceRow">
            <Border x:Name="Row" BorderBrush="{StaticResource CardBorder}" BorderThickness="0,1,0,0" Padding="0,8,0,8">
                <ContentPresenter Content="{Binding}" />
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource PreviousData}}" Value="{x:Null}">
                    <Setter TargetName="Row" Property="BorderThickness" Value="0" />
                    <Setter TargetName="Row" Property="Padding" Value="0,0,0,8" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:DoorViewModel}">
            <Grid Margin="0,2,12,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="DoorState" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="StateText" Grid.Column="1" Text="{Binding State}" Margin="6,0,8,0"
                           VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}" />
                <Button Grid.Column="2" Content="{Binding ActionText}" Command="{Binding ToggleCommand}" MinWidth="56"
                        AutomationProperties.Name="{Binding ActionName}" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding State}" Value="Open">
                    <Setter TargetName="StateText" Property="Foreground" Value="{StaticResource Warn}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Unknown">
                    <Setter TargetName="StateText" Property="Foreground" Value="{StaticResource TextDisabled}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="140" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="200" MinHeight="90" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="14,12,14,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" Margin="0,1,7,0" VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource Warn}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Connection}" Value="FakeSim">
                                        <Setter Property="Fill" Value="{StaticResource Accent}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Connection}" Value="Msfs">
                                        <Setter Property="Fill" Value="{StaticResource Good}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding ConnectionText}" Style="{StaticResource Muted}" />
                </StackPanel>
                <TextBlock Text="{Binding AircraftTitle}" FontSize="17" FontWeight="SemiBold" Margin="0,4,0,0"
                           TextTrimming="CharacterEllipsis" ToolTip="{Binding AircraftTitle}" />
                <TextBlock Text="{Binding ProfileText}" Style="{StaticResource Muted}" Margin="0,2,0,0" />
            </StackPanel>
            <CheckBox Grid.Column="1" Content="Always on top" Style="{StaticResource Switch}" VerticalAlignment="Top" Margin="12,0,0,0"
                      IsChecked="{Binding Topmost, RelativeSource={RelativeSource AncestorType=Window}}" />
        </Grid>

        <StackPanel Grid.Row="1">
            <!-- Adapter problem -->
            <Border Margin="14,0,14,10" Padding="10,8" CornerRadius="6" BorderThickness="1"
                    Background="{StaticResource WarnBackground}" BorderBrush="{StaticResource WarnBorder}"
                    Visibility="{Binding HasAdapterProblem, Converter={StaticResource VisibleWhen}}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Text="&#xE7BA;" FontFamily="{StaticResource IconFont}" FontSize="14"
                               Foreground="{StaticResource Warn}" Margin="0,1,10,0" VerticalAlignment="Top" />
                    <TextBlock Text="{Binding AdapterProblem}" Foreground="{StaticResource Warn}" TextWrapping="Wrap" />
                </DockPanel>
            </Border>

            <!-- New version available: one button downloads it, opens the installer and closes Rampside -->
            <Border Margin="14,0,14,10" Padding="10,6,6,6" CornerRadius="6" BorderThickness="1"
                    Background="{StaticResource AccentBackground}" BorderBrush="{StaticResource AccentBorder}"
                    DataContext="{Binding Updates}"
                    Visibility="{Binding ShowBanner, Converter={StaticResource VisibleWhen}}">
                <StackPanel>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Text="&#xE896;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                   Foreground="{StaticResource Accent}" Margin="0,0,10,0" VerticalAlignment="Center" />
                        <!-- Fixed width, wide enough for "Downloading…", so the button never jumps. -->
                        <Button DockPanel.Dock="Right" Content="{Binding InstallButtonText}" Command="{Binding InstallCommand}"
                                Style="{StaticResource ProgressButton}" Width="116" Margin="10,0,0,0"
                                ToolTip="{Binding InstallHint}" AutomationProperties.Name="Update Rampside" />
                        <TextBlock Text="{Binding BannerText}" TextWrapping="Wrap" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock Text="{Binding UpdateError}" Foreground="{StaticResource Bad}" TextWrapping="Wrap" Margin="24,6,0,2"
                               Visibility="{Binding HasUpdateError, Converter={StaticResource VisibleWhen}}" />
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Result of the last command -->
        <Border Grid.Row="2" Margin="14,0,14,10" Padding="10,7" CornerRadius="6" BorderThickness="1"
                Visibility="{Binding HasStatus, Converter={StaticResource VisibleWhen}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{StaticResource CardBackground}" />
                    <Setter Property="BorderBrush" Value="{StaticResource CardBorder}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                            <Setter Property="Background" Value="{StaticResource BadBackground}" />
                            <Setter Property="BorderBrush" Value="{StaticResource BadBorder}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding StatusTime}" Style="{StaticResource Muted}" FontSize="11"
                           Margin="10,1,0,0" VerticalAlignment="Top" />
                <TextBlock DockPanel.Dock="Left" FontFamily="{StaticResource IconFont}" FontSize="14" Margin="0,1,10,0" VerticalAlignment="Top">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="&#xE73E;" />
                            <Setter Property="Foreground" Value="{StaticResource Good}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                    <Setter Property="Text" Value="&#xE783;" />
                                    <Setter Property="Foreground" Value="{StaticResource Bad}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource Bad}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </DockPanel>
        </Border>

        <!-- One tab per job at the stand. Rows update in place, so switching tabs keeps typed input. -->
        <TabControl Grid.Row="3" x:Name="Tabs">

            <!-- Gate: stand, jetway/stairs/ground power, doors -->
            <TabItem AutomationProperties.Name="Gate">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Gate" />
                        <Ellipse Style="{StaticResource TabBusyDot}" Visibility="{Binding GateBusy, Converter={StaticResource VisibleWhen}}" />
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer Style="{StaticResource TabPage}">
                    <StackPanel>
                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="Stand" Style="{StaticResource Label}" />
                                <TextBlock Grid.Column="1" Text="{Binding StandText}" Style="{StaticResource Value}" />
                                <TextBlock Grid.Row="1" Text="Jetway" Style="{StaticResource Label}" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding JetwayText}" Style="{StaticResource Value}" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="EQUIPMENT" Style="{StaticResource SectionTitle}" Margin="0,0,0,6" />
                                <TextBlock Text="Available once the simulator and the user aircraft are ready."
                                           Style="{StaticResource Muted}" TextWrapping="Wrap"
                                           Visibility="{Binding HasServices, Converter={StaticResource CollapsedWhen}}" />
                                <ItemsControl ItemsSource="{Binding GateServices}" ItemTemplate="{StaticResource ServiceRow}"
                                              Grid.IsSharedSizeScope="True" Focusable="False" />
                                <ItemsControl ItemsSource="{Binding OtherServices}" ItemTemplate="{StaticResource ServiceRow}"
                                              Grid.IsSharedSizeScope="True" Focusable="False" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Visibility="{Binding HasDoors, Converter={StaticResource VisibleWhen}}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,6">
                                    <Button DockPanel.Dock="Right" Content="Close all" Command="{Binding CloseAllDoorsCommand}"
                                            AutomationProperties.Name="Close all doors" />
                                    <TextBlock Text="DOORS" Style="{StaticResource SectionTitle}" />
                                </DockPanel>
                                <ItemsControl ItemsSource="{Binding Doors}" Margin="0,0,-12,0" Focusable="False" Grid.IsSharedSizeScope="True">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="2" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Boarding -->
            <TabItem AutomationProperties.Name="Boarding">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Boarding" />
                        <Ellipse Style="{StaticResource TabBusyDot}"
                                 Visibility="{Binding Passengers.IsBusy, Converter={StaticResource VisibleWhen}, FallbackValue=Collapsed}" />
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer Style="{StaticResource TabPage}">
                    <StackPanel>
                        <!-- SimBrief flight plan: passengers, cargo and block fuel for boarding and refueling -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,6">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <Button Content="Load anyway" Command="{Binding ForceLoadFlightPlanCommand}" Style="{StaticResource ActionButton}"
                                                AutomationProperties.Name="Load the refused flight plan anyway"
                                                Visibility="{Binding CanForceLoadFlightPlan, Converter={StaticResource VisibleWhen}}" />
                                        <Button Content="Load from SimBrief" Command="{Binding LoadFlightPlanCommand}" Style="{StaticResource PrimaryAction}"
                                                AutomationProperties.Name="Load flight plan from SimBrief" />
                                    </StackPanel>
                                    <TextBlock Text="FLIGHT PLAN" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                                </DockPanel>
                                <TextBlock Text="{Binding FlightPlanText}" Style="{StaticResource Value}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding FlightPlanNotes}" Foreground="{StaticResource Warn}" TextWrapping="Wrap" Margin="0,6,0,0"
                                           Visibility="{Binding HasFlightPlanNotes, Converter={StaticResource VisibleWhen}}" />
                                <TextBlock Text="{Binding FlightPlanHint}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="On board" Style="{StaticResource Label}" />
                                <TextBlock Grid.Column="1" Text="{Binding PassengersText}" Style="{StaticResource Value}" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <ContentControl Content="{Binding Passengers}" Focusable="False" Grid.IsSharedSizeScope="True" />
                                <TextBlock Text="Jetway or stairs must be connected. Cargo doors open and close automatically when the aircraft supports it."
                                           Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,10,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Refueling -->
            <TabItem AutomationProperties.Name="Refueling">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Refueling" />
                        <Ellipse Style="{StaticResource TabBusyDot}"
                                 Visibility="{Binding Refueling.IsBusy, Converter={StaticResource VisibleWhen}, FallbackValue=Collapsed}" />
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer Style="{StaticResource TabPage}">
                    <StackPanel>
                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="Fuel" Style="{StaticResource Label}" />
                                <TextBlock Grid.Column="1" Text="{Binding FuelText}" Style="{StaticResource Value}" />
                                <TextBlock Grid.Row="1" Text="Engines" Style="{StaticResource Label}" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding EnginesText}" Style="{StaticResource Value}" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <ContentControl Content="{Binding Refueling}" Focusable="False" Grid.IsSharedSizeScope="True" />
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Pushback -->
            <TabItem AutomationProperties.Name="Pushback">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Pushback" />
                        <Ellipse Style="{StaticResource TabBusyDot}"
                                 Visibility="{Binding Pushback.IsBusy, Converter={StaticResource VisibleWhen}, FallbackValue=Collapsed}" />
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer Style="{StaticResource TabPage}">
                    <StackPanel>
                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="Parking brake" Style="{StaticResource Label}" />
                                <TextBlock Grid.Column="1" Text="{Binding ParkingBrakeText}" Style="{StaticResource Value}" />
                                <TextBlock Grid.Column="2" Text="Ground speed" Style="{StaticResource Label}" />
                                <TextBlock Grid.Column="3" Text="{Binding GroundSpeedText}" Style="{StaticResource Value}" />
                                <TextBlock Grid.Row="1" Text="Heading" Style="{StaticResource Label}" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding HeadingText}" Style="{StaticResource Value}" />
                                <TextBlock Grid.Row="1" Grid.Column="2" Text="On ground" Style="{StaticResource Label}" />
                                <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding OnGroundText}" Style="{StaticResource Value}" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <ContentControl Content="{Binding Pushback}" Focusable="False" Grid.IsSharedSizeScope="True" />
                                <TextBlock Text="Jetway, stairs and ground power must be disconnected and all doors closed. Release the parking brake once the tug is connected."
                                           Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,10,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Settings, saved in %APPDATA%\Rampside\settings.json -->
            <TabItem Header="Settings" AutomationProperties.Name="Settings">
                <ScrollViewer Style="{StaticResource TabPage}">
                    <StackPanel>
                        <!-- Reposition: search a stand of the current airport and move the aircraft there. -->
                        <Border Style="{StaticResource Card}" DataContext="{Binding Reposition}">
                            <StackPanel>
                                <TextBlock Text="REPOSITION" Style="{StaticResource SectionTitle}" Margin="0,0,0,6" />
                                <TextBox Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" Tag="Search stand, e.g. 121"
                                         AutomationProperties.Name="Search stand"
                                         Visibility="{Binding HasParkings, Converter={StaticResource VisibleWhen}}" />
                                <ItemsControl ItemsSource="{Binding Results}" Focusable="False" Margin="0,6,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,6">
                                                <Button Content="{Binding Name}" Command="{Binding SelectCommand}" Style="{StaticResource ActionButton}"
                                                        Visibility="{Binding IsSelected, Converter={StaticResource CollapsedWhen}}"
                                                        AutomationProperties.Name="{Binding Name}" />
                                                <Button Content="{Binding Name}" Command="{Binding SelectCommand}" Style="{StaticResource PrimaryAction}"
                                                        Visibility="{Binding IsSelected, Converter={StaticResource VisibleWhen}}"
                                                        AutomationProperties.Name="{Binding Name, StringFormat='{}{0}, selected'}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding Hint}" Style="{StaticResource Muted}" TextWrapping="Wrap" />
                                <DockPanel Margin="0,6,0,0" Visibility="{Binding HasParkings, Converter={StaticResource VisibleWhen}}">
                                    <Button DockPanel.Dock="Right" Content="Move aircraft" Command="{Binding MoveCommand}"
                                            Style="{StaticResource PrimaryAction}" Margin="0" />
                                    <TextBlock Text="{Binding SelectedText}" Style="{StaticResource Value}" VerticalAlignment="Center" />
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" DataContext="{Binding Settings}">
                            <StackPanel>
                                <TextBlock Text="SIMBRIEF" Style="{StaticResource SectionTitle}" Margin="0,0,0,6" />
                                <TextBlock Text="Pilot ID or username" Style="{StaticResource Label}" Margin="0,0,0,4" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBox Width="220" Margin="0,0,6,0" Tag="e.g. 123456 or MYNAME" AutomationProperties.Name="SimBrief pilot ID or username"
                                             Text="{Binding SimBriefUser, UpdateSourceTrigger=PropertyChanged}">
                                        <TextBox.InputBindings>
                                            <KeyBinding Key="Return" Command="{Binding SaveCommand}" />
                                        </TextBox.InputBindings>
                                    </TextBox>
                                    <Button Content="Save" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryAction}"
                                            AutomationProperties.Name="Save SimBrief user" />
                                    <Button Content="Test" Command="{Binding TestSimBriefCommand}" Style="{StaticResource ActionButton}"
                                            AutomationProperties.Name="Test SimBrief user" />
                                </StackPanel>
                                <TextBlock Text="{Binding SimBriefResult}" TextWrapping="Wrap" Margin="0,8,0,0"
                                           Visibility="{Binding HasSimBriefResult, Converter={StaticResource VisibleWhen}}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource Good}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SimBriefResultIsError}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource Bad}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0"
                                           Text="Your pilot ID is on simbrief.com under Account Settings. Rampside loads your latest plan only when you press Load on the Boarding tab." />
                                <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0" FontSize="11"
                                           Text="{Binding SettingsPath, StringFormat=Saved in {0}}" />
                            </StackPanel>
                        </Border>

                        <!-- Ground crew voice: on/off and a sample line -->
                        <Border Style="{StaticResource Card}" DataContext="{Binding Settings}">
                            <StackPanel>
                                <TextBlock Text="GROUND CREW VOICE" Style="{StaticResource SectionTitle}" Margin="0,0,0,6" />
                                <StackPanel Orientation="Horizontal">
                                    <CheckBox Content="Crew talks to the cockpit" Style="{StaticResource Switch}" VerticalAlignment="Center"
                                              IsChecked="{Binding CrewVoiceEnabled}" IsEnabled="{Binding HasCrewVoice}"
                                              AutomationProperties.Name="Ground crew voice" Margin="0,0,12,0" />
                                    <Button Content="Play sample" Command="{Binding PlayCrewVoiceSampleCommand}" Style="{StaticResource ActionButton}"
                                            AutomationProperties.Name="Play a ground crew voice sample" />
                                </StackPanel>
                                <TextBlock Text="{Binding CrewVoiceNote}" Foreground="{StaticResource Bad}" TextWrapping="Wrap" Margin="0,8,0,0"
                                           Visibility="{Binding HasCrewVoiceNote, Converter={StaticResource VisibleWhen}}" />
                                <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0" Text="{Binding CrewVoiceHint}" />
                            </StackPanel>
                        </Border>

                        <!-- Updates: version, check at start, check now -->
                        <Border Style="{StaticResource Card}" DataContext="{Binding Updates}">
                            <StackPanel>
                                <TextBlock Text="UPDATES" Style="{StaticResource SectionTitle}" Margin="0,0,0,6" />
                                <TextBlock Text="{Binding CurrentVersionText}" Style="{StaticResource Value}" Margin="0,0,0,8" />
                                <StackPanel Orientation="Horizontal">
                                    <CheckBox Content="Check when Rampside starts" Style="{StaticResource Switch}" VerticalAlignment="Center"
                                              IsChecked="{Binding CheckAtStart}" AutomationProperties.Name="Check for updates when Rampside starts"
                                              Margin="0,0,12,0" />
                                    <Button Content="Check now" Command="{Binding CheckNowCommand}" Style="{StaticResource ActionButton}"
                                            AutomationProperties.Name="Check for updates now" />
                                </StackPanel>
                                <TextBlock Text="{Binding CheckResult}" TextWrapping="Wrap" Margin="0,8,0,0"
                                           Visibility="{Binding HasCheckResult, Converter={StaticResource VisibleWhen}}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource Good}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CheckResultIsError}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource Bad}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0"
                                           Text="Rampside only asks the Rampside website for the latest version number. An update is installed only when you press Update." />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Fake simulator tools -->
            <TabItem Header="Test" AutomationProperties.Name="Test"
                     Visibility="{Binding UsingFakeSim, Converter={StaticResource VisibleWhen}}">
                <ScrollViewer Style="{StaticResource TabPage}">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="FAKE SIMULATOR" Style="{StaticResource SectionTitle}" Margin="0,0,0,6" />
                            <WrapPanel>
                                <Button Content="{Binding ParkingBrakeButtonText}" Command="{Binding ToggleParkingBrakeCommand}" Style="{StaticResource ActionButton}" />
                                <Button Content="{Binding EnginesButtonText}" Command="{Binding ToggleEnginesCommand}" Style="{StaticResource ActionButton}" />
                                <Button Content="{Binding DcPowerButtonText}" Command="{Binding ToggleDcPowerCommand}" Style="{StaticResource ActionButton}"
                                        Visibility="{Binding HasFakePmdg, Converter={StaticResource VisibleWhen}}" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <GridSplitter Grid.Row="4" Height="6" HorizontalAlignment="Stretch" Background="Transparent" Focusable="False"
                      ResizeBehavior="PreviousAndNext" ResizeDirection="Rows" />

        <!-- Log -->
        <Border Grid.Row="5" Style="{StaticResource Card}" Margin="14,0,14,14" Padding="8,8,2,8">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="LOG" Style="{StaticResource SectionTitle}" Margin="4,0,0,4" />
                <!-- Read-only rich text, so lines can be selected with the mouse and copied (Ctrl+C or right click). -->
                <RichTextBox x:Name="LogBox" IsReadOnly="True" IsReadOnlyCaretVisible="False" IsUndoEnabled="False"
                             Background="Transparent" BorderThickness="0" Padding="0"
                             Foreground="{StaticResource TextPrimary}" FontFamily="{StaticResource MonoFont}" FontSize="12"
                             SelectionBrush="{StaticResource Accent}" SelectionOpacity="0.35"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.ScrollChanged="OnLogScrollChanged" AutomationProperties.Name="Log">
                    <FlowDocument x:Name="LogDocument" PagePadding="0" />
                </RichTextBox>
            </DockPanel>
        </Border>
    </Grid>
</Window>
